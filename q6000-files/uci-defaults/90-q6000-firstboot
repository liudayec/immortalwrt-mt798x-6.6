#!/bin/sh
# Q6000 首次启动初始化（编译期注入，只执行一次）
# 1) root 密码  2) 5G MAC  3) quickstart 无线菜单  4) 语言/主题

# --- 1) root 密码: liuyeye123 ---
HASH='$1$q6000$W7N22kDgu.pAxJ/zW0uWV0'
if [ -f /etc/shadow ]; then
	awk -F: -v h="$HASH" 'BEGIN{OFS=":"} $1=="root"{$2=h} {print}' /etc/shadow > /tmp/.shadow.new 2>/dev/null
	if [ -s /tmp/.shadow.new ]; then
		mv /tmp/.shadow.new /etc/shadow
		chmod 600 /etc/shadow
	fi
fi

# --- 2) 5G MAC = 2G MAC + 2 ---
M2=$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null | tr 'A-F' 'a-f')
if [ -n "$M2" ]; then
	LAST=${M2##*:}
	BASE=${M2%:*}
	N=$((0x$LAST + 2))
	M5=$(printf "%s:%02x" "$BASE" $((N % 256)))
	if uci -q get wireless.default_radio1 >/dev/null; then
		uci set wireless.default_radio1.macaddr="$M5"
	fi
fi

# --- 3) quickstart 的「无线」菜单：其目标路由为空（上游 bug），默认关闭 ---
uci -q get quickstart.main >/dev/null 2>&1 || uci set quickstart.main=quickstart
uci set quickstart.main.wifi_menu='0'

# --- 4) 语言 + 主题 ---
uci set luci.main.lang='zh_cn'
uci set luci.main.mediaurlbase='/luci-static/argon'

uci commit
exit 0
